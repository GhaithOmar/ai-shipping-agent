# ==== Model & adapters (safe defaults) ====
BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
FALLBACK_BASE=TinyLlama/TinyLlama-1.1B-Chat-v1.0
ADAPTER_ID=

# If you have an HF token, set it at runtime (do NOT commit real token)
HUGGINGFACE_TOKEN=
HF_TOKEN=

# ==== Agent behavior ====
AGENT_OFFLINE=0
AGENT_ENABLE=true
AGENT_TOP_K=4

# ==== Retrieval / Qdrant (match your defaults in settings.py) ====
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=shipping_kb

# ==== Misc runtime ====
PORT=8000
TOKENIZERS_PARALLELISM=false
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
HF_HOME=/app/hf_cache
