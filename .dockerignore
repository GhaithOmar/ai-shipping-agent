# ── VCS ────────────────────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Python build/cache ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/

# ── Virtual envs & local env files ────────────────────────────────────────────
.venv/
.env
.env.*
!.env.example   # keep the example

# ── Notebooks & checkpoints (we don’t ship them in the runtime image) ─────────
notebooks/
**/*.ipynb
.ipynb_checkpoints/

# ── Data & caches (mounted by docker-compose at runtime) ──────────────────────
data/
datasets/
qdrant_db/
rag/data/
hf_cache/
cache/
*.csv
*.parquet
*.zip

# ── Tests (optional: exclude to slim the runtime image) ───────────────────────
tests/

# ── Node/misc build folders ───────────────────────────────────────────────────
node_modules/
dist/
build/

# ── Editor/OS cruft ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
.vscode/
.idea/

# ── Docs (keep sources; skip big PDFs if you want) ────────────────────────────
*.pdf
